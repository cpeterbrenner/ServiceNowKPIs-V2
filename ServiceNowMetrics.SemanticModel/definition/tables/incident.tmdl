			defaultHierarchy: LocalDateTable_e63d7edc-fe18-4b0c-94ed-bc930cea323e.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Is Unassigned' = COALESCE(incident[assigned_to], "") = ""
		dataType: boolean
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000008
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Open Lt 30 Days' = incident[Is Active Open Incident] = TRUE() && DATEDIFF(incident[opened_at], TODAY(), DAY) < 30
		dataType: boolean
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000009
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Open 30 To 60 Days' = incident[Is Active Open Incident] = TRUE() && DATEDIFF(incident[opened_at], TODAY(), DAY) >= 30 && DATEDIFF(incident[opened_at], TODAY(), DAY) <= 60
		dataType: boolean
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000010
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Open Gt 60 Days' = incident[Is Active Open Incident] = TRUE() && DATEDIFF(incident[opened_at], TODAY(), DAY) > 60
		dataType: boolean
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000011
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Resolved Month' = IF(NOT(ISBLANK(incident[resolved_at])), DATE(YEAR(incident[resolved_at]), MONTH(incident[resolved_at]), 1), BLANK())
		dataType: dateTime
		formatString: MMM yyyy
		displayFolder: MTTR
		lineageTag: c1a00002-0000-0000-0000-000000000012
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 5bbb4b65-3c4f-4159-92ac-6791ee05918e
			defaultHierarchy: LocalDateTable_3c23e55c-6586-4c4d-a7f4-e40564adeaee.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Is Active Open Incident' =
			incident[active] = TRUE()
			&& NOT(incident[state] IN {"Resolved", "Closed"})
			&& ISBLANK(incident[resolved_at])
			&& ISBLANK(incident[closed_at])
		dataType: boolean
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000013
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Closed Ticket' =
			incident[active] = FALSE()
			|| incident[incident_state] IN {"Resolved", "Closed"}
		dataType: boolean
		displayFolder: Productivity
		lineageTag: c1a00002-0000-0000-0000-000000000014
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Reopened Date' = incident[reopened_time]
		dataType: dateTime
		formatString: General Date
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000015
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column parent
		dataType: string
		lineageTag: 08f8ad22-35c1-4eb0-a2c7-49fe468b9380
		summarizeBy: none
		sourceColumn: parent

		annotation SummarizationSetBy = Automatic

	column 'Is Open 60 To 90 Days' = incident[Is Active Open Incident] = TRUE() && DATEDIFF(incident[opened_at], TODAY(), DAY) > 60 && DATEDIFF(incident[opened_at], TODAY(), DAY) <= 90
		dataType: boolean
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000020
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Open Gt 90 Days' = incident[Is Active Open Incident] = TRUE() && DATEDIFF(incident[opened_at], TODAY(), DAY) > 90
		dataType: boolean
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000021
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Open Age Bucket' =
			IF(
				incident[Is Active Open Incident] = TRUE(),
				SWITCH(
					TRUE(),
					DATEDIFF(incident[opened_at], TODAY(), DAY) < 30, "0 - 30 Days",
					DATEDIFF(incident[opened_at], TODAY(), DAY) <= 60, "30 - 60 Days",
					DATEDIFF(incident[opened_at], TODAY(), DAY) <= 90, "60 - 90 Days",
					"Over 90 Days"
				)
			)
		dataType: string
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000022
		summarizeBy: none
		sortByColumn: 'Open Age Bucket Order'

		annotation SummarizationSetBy = Automatic

	column 'Open Age Bucket Order' =
			IF(
				incident[Is Active Open Incident] = TRUE(),
				SWITCH(
					TRUE(),
					DATEDIFF(incident[opened_at], TODAY(), DAY) < 30, 1,
					DATEDIFF(incident[opened_at], TODAY(), DAY) <= 60, 2,
					DATEDIFF(incident[opened_at], TODAY(), DAY) <= 90, 3,
					4
				)
			)
		dataType: int64
		displayFolder: Active Incidents
		lineageTag: c1a00002-0000-0000-0000-000000000023
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Ticket Channel' =
			VAR ContactType = UPPER(TRIM(COALESCE(incident[contact_type], "")))
			RETURN
				SWITCH(
					TRUE(),
					ContactType = "WALK-IN", "Walk in",
					ContactType = "SELF-SERVICE", "Self Service",
					ContactType = "EMAIL", "Email",
					ContactType = "PHONE", "Phone",
					"Other"
				)
		dataType: string
		displayFolder: KPIs
		lineageTag: c1a00002-0000-0000-0000-000000000040
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Record Type' = IF(LEFT(incident[number], 4) = "RITM", "Request", "Incident")
		dataType: string
		displayFolder: Volume
		lineageTag: c1a00002-0000-0000-0000-000000000050
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Opened Month' = IF(NOT(ISBLANK(incident[opened_at])), DATE(YEAR(incident[opened_at]), MONTH(incident[opened_at]), 1), BLANK())
		dataType: dateTime
		formatString: MMM yyyy
		displayFolder: Volume
		lineageTag: c1a00002-0000-0000-0000-000000000051
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

