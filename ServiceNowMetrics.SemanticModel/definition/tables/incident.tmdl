	measure 'Open Age Bucket Color' =
			SWITCH(
				SELECTEDVALUE(incident[Open Age Bucket Order]),
				1, "#008000",
				2, "#FFC000",
				3, "#FF6B35",
				4, "#C00000",
				"#B3B3B3"
			)
		displayFolder: KPIs
