	measure 'MTTR Gauge Min' = 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000040

	measure 'MTTR Gauge Max' = 20 + [Overall MTTR Hours SLA Critical]
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000041

	measure 'MTTR Gauge Color' =
			VAR MttrValue = [MTTR Business Hours]
			VAR BaseVal = [Overall MTTR Hours SLA Base]
			VAR CautionVal = [Overall MTTR Hours SLA Caution]
			VAR WarnVal = [Overall MTTR Hours SLA Warn]
			RETURN
				SWITCH(
					TRUE(),
					MttrValue >= WarnVal, "#C00000",
					MttrValue > CautionVal, "#FF6B35",
					MttrValue > BaseVal, "#FFC000",
					"#008000"
				)
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000042

	measure 'Open Incidents 60-90 Days' = CALCULATE(COUNTROWS(incident), incident[Is Open 60 To 90 Days] = TRUE(), REMOVEFILTERS(incident[opened_at]))
		formatString: #,0
