	measure 'Incident Volume' = CALCULATE(COUNTROWS(incident), incident[Record Type] = "Incident")
		formatString: #,0
		displayFolder: Volume
		lineageTag: c1a00001-0000-0000-0000-000000000050

	measure 'Request Volume' = CALCULATE(COUNTROWS(incident), incident[Record Type] = "Request")
		formatString: #,0
