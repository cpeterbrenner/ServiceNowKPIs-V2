	measure 'Rolling 12 Month Opened Filter' =
			VAR MinAllowed = DATE(YEAR(EDATE(TODAY(), -11)), MONTH(EDATE(TODAY(), -11)), 1)
			VAR MaxAllowed = EOMONTH(TODAY(), 0)
			VAR CurrentMonth = SELECTEDVALUE(incident[Opened Month])
			RETURN
				IF(
					NOT(ISBLANK(CurrentMonth)) && CurrentMonth >= MinAllowed && CurrentMonth <= MaxAllowed,
					1,
					BLANK()
				)
		isHidden
		displayFolder: Volume
		lineageTag: c1a00001-0000-0000-0000-000000000052

	measure 'Incident Volume Trend' =
			VAR MinAllowed = DATE(YEAR(EDATE(TODAY(), -11)), MONTH(EDATE(TODAY(), -11)), 1)
			VAR MaxAllowed = EOMONTH(TODAY(), 0)
			VAR PointsTable =
				SELECTCOLUMNS(
					FILTER(
						ADDCOLUMNS(
							CALCULATETABLE(VALUES(incident[Opened Month]), REMOVEFILTERS(incident[Opened Month])),
							"PointY", CALCULATE([Incident Volume])
						),
						NOT(ISBLANK(incident[Opened Month]))
							&& incident[Opened Month] >= MinAllowed
							&& incident[Opened Month] <= MaxAllowed
							&& NOT(ISBLANK([PointY]))
					),
					"PointX", VALUE(incident[Opened Month]),
					"PointY", [PointY]
				)
			VAR LineStats = LINESTX(PointsTable, [PointY], [PointX])
			VAR Slope = MAXX(LineStats, [Slope1])
			VAR Intercept = MAXX(LineStats, [Intercept])
			VAR CurrentX = VALUE(SELECTEDVALUE(incident[Opened Month]))
			RETURN
				IF(
					COUNTROWS(PointsTable) >= 2 && NOT(ISBLANK(CurrentX)),
					Intercept + Slope * CurrentX,
					BLANK()
				)
		formatString: #,0
		displayFolder: Volume
		lineageTag: c1a00001-0000-0000-0000-000000000053

	measure 'Request Volume Trend' =
			VAR MinAllowed = DATE(YEAR(EDATE(TODAY(), -11)), MONTH(EDATE(TODAY(), -11)), 1)
			VAR MaxAllowed = EOMONTH(TODAY(), 0)
			VAR PointsTable =
				SELECTCOLUMNS(
					FILTER(
						ADDCOLUMNS(
							CALCULATETABLE(VALUES(incident[Opened Month]), REMOVEFILTERS(incident[Opened Month])),
							"PointY", CALCULATE([Request Volume])
						),
						NOT(ISBLANK(incident[Opened Month]))
							&& incident[Opened Month] >= MinAllowed
							&& incident[Opened Month] <= MaxAllowed
							&& NOT(ISBLANK([PointY]))
					),
					"PointX", VALUE(incident[Opened Month]),
					"PointY", [PointY]
				)
			VAR LineStats = LINESTX(PointsTable, [PointY], [PointX])
			VAR Slope = MAXX(LineStats, [Slope1])
			VAR Intercept = MAXX(LineStats, [Intercept])
			VAR CurrentX = VALUE(SELECTEDVALUE(incident[Opened Month]))
			RETURN
				IF(
					COUNTROWS(PointsTable) >= 2 && NOT(ISBLANK(CurrentX)),
					Intercept + Slope * CurrentX,
					BLANK()
				)
		formatString: #,0
		displayFolder: Volume
		lineageTag: c1a00001-0000-0000-0000-000000000054

