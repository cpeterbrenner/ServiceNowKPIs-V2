table incident
	lineageTag: 1308affd-de74-429a-b841-85061dd18a19

	measure 'Total Incidents' = COUNTROWS(incident)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000001

	measure 'Total Resolved Incidents' =
			CALCULATE(
				COUNTROWS(incident),
				FILTER(
					incident,
					NOT(ISBLANK(incident[resolved_at])) || NOT(ISBLANK(incident[closed_at]))
				)
			)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000002

	measure 'Active/Open Incidents' = CALCULATE(COUNTROWS(incident), incident[Is Active Open Incident] = TRUE(), REMOVEFILTERS(incident[opened_at]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000003

	measure 'Unassigned Incidents' = CALCULATE(COUNTROWS(incident), incident[active] = TRUE(), COALESCE(incident[assigned_to], "") = "", REMOVEFILTERS(incident[opened_at]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000004

	measure 'Avg Age of Open Incidents (Days)' = AVERAGEX(FILTER(incident, incident[active] = TRUE()), DATEDIFF(incident[opened_at], TODAY(), DAY))
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000005

	measure 'Open Incidents < 30 Days' = CALCULATE(COUNTROWS(incident), incident[Is Open Lt 30 Days] = TRUE(), REMOVEFILTERS(incident[opened_at]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000006

	measure 'Open Incidents 30-60 Days' = CALCULATE(COUNTROWS(incident), incident[Is Open 30 To 60 Days] = TRUE(), REMOVEFILTERS(incident[opened_at]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000007

	measure 'Open Incidents > 60 Days' = CALCULATE(COUNTROWS(incident), incident[Is Open Gt 60 Days] = TRUE(), REMOVEFILTERS(incident[opened_at]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000008

	measure 'MTTR Business Hours' = DIVIDE(CALCULATE(AVERAGE(incident[business_duration]), NOT(ISBLANK(incident[resolved_at]))), 3600)
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000009

	measure 'MTTR Business Days' = DIVIDE(CALCULATE(AVERAGE(incident[business_duration]), NOT(ISBLANK(incident[resolved_at]))), 28800)
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000010

	measure 'Oldest Unassigned Incident (Days)' = CALCULATE(MAXX(FILTER(incident, incident[active] = TRUE() && COALESCE(incident[assigned_to], "") = ""), DATEDIFF(incident[opened_at], TODAY(), DAY)), REMOVEFILTERS(incident[opened_at]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000011

	measure 'Oldest Assigned Unresolved Incident (Days)' = CALCULATE(MAXX(FILTER(incident, incident[active] = TRUE() && COALESCE(incident[assigned_to], "") <> "" && ISBLANK(incident[resolved_at])), DATEDIFF(incident[opened_at], TODAY(), DAY)), REMOVEFILTERS(incident[opened_at]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000012

	measure 'Record Count' = COUNTROWS(incident)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000013

	measure 'Record Count Label' =
			VAR RowCount =
				CALCULATE(
					COUNTROWS(incident),
					ALLEXCEPT(
						incident,
						incident[active],
						incident[Is Active Open Incident],
						incident[Is Unassigned],
						incident[Is Open Lt 30 Days],
						incident[Is Open 30 To 60 Days],
						incident[Is Open Gt 60 Days],
						incident[Is Open 60 To 90 Days],
						incident[Is Open Gt 90 Days]
					)
				)
			RETURN
				FORMAT(RowCount, "#,0") & " Record Count"
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000014

	measure 'Rolling 12 Month Filter' =
			VAR MinAllowed = EDATE(EOMONTH(TODAY(), -1), -11)
			VAR MaxAllowed = EOMONTH(TODAY(), 0)
			VAR CurrentMonth = SELECTEDVALUE(incident[Resolved Month])
			RETURN
				IF(
					NOT(ISBLANK(CurrentMonth)) && CurrentMonth >= MinAllowed && CurrentMonth <= MaxAllowed,
					1,
					BLANK()
				)
		isHidden
		displayFolder: KPIs
		lineageTag: c1a00001-0000-0000-0000-000000000015

	measure 'MTTR Trend Line' =
			VAR PointsTable =
				SELECTCOLUMNS(
					FILTER(
						ADDCOLUMNS(
							ALLSELECTED(incident[Resolved Month]),
							"PointY", CALCULATE([MTTR Business Hours])
						),
						NOT(ISBLANK(incident[Resolved Month])) && NOT(ISBLANK([PointY]))
					),
					"PointX", VALUE(incident[Resolved Month]),
					"PointY", [PointY]
				)
			VAR LineStats = LINESTX(PointsTable, [PointY], [PointX])
			VAR Slope = MAXX(LineStats, [Slope1])
			VAR Intercept = MAXX(LineStats, [Intercept])
			VAR CurrentX = VALUE(SELECTEDVALUE(incident[Resolved Month]))
			RETURN
				IF(
					COUNTROWS(PointsTable) >= 2 && NOT(ISBLANK(CurrentX)),
					Intercept + Slope * CurrentX,
					BLANK()
				)
		formatString: #,0.0
		displayFolder: MTTR
		lineageTag: c1a00001-0000-0000-0000-000000000016

	measure 'Active/Open Border Color' =
			VAR ActiveCount = [Active/Open Incidents]
			VAR SlaRow =
				FILTER(
					ALL(SLA),
					SUBSTITUTE(LOWER(TRIM(SLA[SLA])), "_", " ") = "open incidents"
				)
			VAR SlaBase = MAXX(SlaRow, SLA[SLA_Base])
			VAR SlaCaution = MAXX(SlaRow, SLA[SLA_Caution])
			VAR SlaWarn = MAXX(SlaRow, SLA[SLA_Warn])
			RETURN
				SWITCH(
					TRUE(),
					NOT(ISBLANK(SlaWarn)) && ActiveCount >= SlaWarn, "#C00000",
					NOT(ISBLANK(SlaCaution)) && NOT(ISBLANK(SlaWarn)) && ActiveCount > SlaCaution && ActiveCount <= SlaWarn, "#FF6B35",
					NOT(ISBLANK(SlaBase)) && NOT(ISBLANK(SlaCaution)) && ActiveCount > SlaBase && ActiveCount <= SlaCaution, "#FFC000",
					NOT(ISBLANK(SlaBase)) && ActiveCount <= SlaBase, "#0B1635",
					"#B3B3B3"
				)
		isHidden
		lineageTag: c1a00001-0000-0000-0000-00000000001b

	measure 'Unassigned Border Color' =
			VAR UnassignedCount = [Unassigned Incidents]
			VAR SlaRow =
				FILTER(
					ALL(SLA),
					SUBSTITUTE(LOWER(TRIM(SLA[SLA])), "_", " ") = "unassigned count"
				)
			VAR SlaBase = MAXX(SlaRow, SLA[SLA_Base])
			VAR SlaCaution = MAXX(SlaRow, SLA[SLA_Caution])
			VAR SlaWarn = MAXX(SlaRow, SLA[SLA_Warn])
			RETURN
				SWITCH(
					TRUE(),
					NOT(ISBLANK(SlaWarn)) && UnassignedCount >= SlaWarn, "#C00000",
					NOT(ISBLANK(SlaCaution)) && NOT(ISBLANK(SlaWarn)) && UnassignedCount > SlaCaution && UnassignedCount <= SlaWarn, "#FF6B35",
					NOT(ISBLANK(SlaBase)) && NOT(ISBLANK(SlaCaution)) && UnassignedCount > SlaBase && UnassignedCount <= SlaCaution, "#FFC000",
					NOT(ISBLANK(SlaBase)) && UnassignedCount <= SlaBase, "#0B1635",
					"#B3B3B3"
				)
		isHidden
		lineageTag: c1a00001-0000-0000-0000-000000000021

	measure 'MTTR Business Hours Border Color' =
			VAR MttrHours = [MTTR Business Hours]
			VAR SlaRow =
				FILTER(
					ALL(SLA),
					SUBSTITUTE(LOWER(TRIM(SLA[SLA])), "_", " ") = "overall mttr hours"
				)
			VAR SlaBase = MAXX(SlaRow, SLA[SLA_Base])
			VAR SlaCaution = MAXX(SlaRow, SLA[SLA_Caution])
			VAR SlaWarn = MAXX(SlaRow, SLA[SLA_Warn])
			VAR SlaCritical = MAXX(SlaRow, SLA[SLA_Critical])
			RETURN
				SWITCH(
					TRUE(),
					NOT(ISBLANK(SlaCritical)) && MttrHours >= SlaCritical, "#C00000",
					NOT(ISBLANK(SlaWarn)) && MttrHours >= SlaWarn, "#FF6B35",
					NOT(ISBLANK(SlaCaution)) && MttrHours >= SlaCaution, "#FFC000",
					NOT(ISBLANK(SlaBase)) && MttrHours <= SlaBase, "#0B1635",
					"#B3B3B3"
				)
		isHidden
		lineageTag: c1a00001-0000-0000-0000-000000000026

