	partition RequestedItems = m
		mode: import
		source =
				let
				  ExpectedColumns = {
				    "number", "opened_at", "incident_state", "category", "short_description",
				    "opened_by", "caller_id", "assignment_group", "active", "assigned_to",
				    "calendar_duration", "business_stc", "reopened_time", "reopened_by", "calendar_stc",
				    "u_time_reported", "activity_due", "u_application", "business_duration", "u_business_process",
				    "contact_type", "child_incidents", "close_code", "closed_at", "closed_by",
				    "company", "u_component", "cmdb_ci", "u_mi_contact_person", "sys_created_on",
				    "sys_created_by", "u_division", "task_effective_number", "reassignment_count", "u_mi_users_impacted",
				    "impact", "u_incident_related_to_company", "u_mi_business_critical", "u_mi_production_environment_affected", "location",
				    "u_note", "u_offering_reassignment_count", "u_rpt_open_duration_test", "parent_incident", "parent",
				    "priority", "u_received_from", "reopen_count", "resolved_at", "resolved_by", "business_service",
				    "service_offering", "severity", "state", "subcategory", "u_service",
				    "u_svc_comp", "sys_updated_on", "sys_updated_by", "sys_mod_count", "upon_approval",
				    "upon_reject", "urgency"
				  },
				  TypeMap = {
				    {"opened_at", type datetime}, {"active", type logical}, {"calendar_duration", Int64.Type},
				    {"reopened_time", type datetime}, {"u_time_reported", type logical}, {"business_duration", Int64.Type},
				    {"child_incidents", Int64.Type}, {"closed_at", type datetime}, {"sys_created_on", type datetime},
				    {"reassignment_count", Int64.Type}, {"u_offering_reassignment_count", Int64.Type},
				    {"u_rpt_open_duration_test", Int64.Type}, {"reopen_count", Int64.Type}, {"resolved_at", type datetime},
				    {"sys_updated_on", type datetime}, {"sys_mod_count", Int64.Type}
				  },
				  Source = Csv.Document(File.Contents("C:\Users\pebren\Development\ServiceNow-KPI\Data\sc_req_item.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  MissingColumns = List.Difference(ExpectedColumns, Table.ColumnNames(#"Promoted headers")),
				  #"Added missing columns" = List.Accumulate(MissingColumns, #"Promoted headers", (state, col) => Table.AddColumn(state, col, each null, type text)),
				  #"Kept export columns" = Table.SelectColumns(#"Added missing columns", ExpectedColumns),
				  ExistingTypeMap = List.Select(TypeMap, each List.Contains(Table.ColumnNames(#"Kept export columns"), _{0})),
				  #"Changed column type" = Table.TransformColumnTypes(#"Kept export columns", ExistingTypeMap),
				  #"Excluded Guest Guest" = Table.SelectRows(#"Changed column type", each [opened_by] <> "Guest Guest")
				in
				  #"Excluded Guest Guest"

	annotation PBI_ResultType = Table

