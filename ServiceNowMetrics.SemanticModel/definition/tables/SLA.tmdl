table SLA
	lineageTag: 29f7f188-458d-4bf1-94bd-56d03c3ea1ac

	measure 'Open Incidents SLA Base' =
			CALCULATE(
				MAX(SLA[SLA_Base]),
				FILTER(
					ALL(SLA),
					SUBSTITUTE(LOWER(TRIM(SLA[SLA])), "_", " ") = "open incidents"
				)
			)
		formatString: 0
		isHidden
		lineageTag: c1a00001-0000-0000-0000-000000000018

